# credential store — never commit resolved secrets, whether at the default
# ~/.sandbox/credentials.yaml or a repo-local override via SANDBOX_CREDENTIALS_PATH
.sandbox/
credentials.yaml

# event logs produced by `sandbox run`
runs/

# scratch output written by the example agents (e.g. examples/agents/file-writer.yaml)
sandbox-core/examples/workspace/*
!sandbox-core/examples/workspace/.gitkeep
