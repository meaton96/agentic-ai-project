        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    }
  },
  "required": [
    "step_id",
    "agent_id",
    "run_id",
    "status"
  ],
  "title": "PipelineStepResult",
  "type": "object"
