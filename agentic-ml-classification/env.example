# Copy this to .env and fill in real values. Never commit .env.

# Image to run. Use the pre-built GHCR image (recommended) rather than
# building locally, unless you need custom apt/pip deps baked in.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Gateway auth token (generate any long random string, e.g. `openssl rand -hex 32`)
OPENCLAW_GATEWAY_TOKEN=

# RIT GenAI API key — required, used as the vllm provider apiKey in openclaw.json
RIT_API_KEY=

# Host paths for bind mounts (defaults match docker-compose.yml if left unset)
OPENCLAW_CONFIG_DIR=./config
OPENCLAW_WORKSPACE_DIR=./workspace
