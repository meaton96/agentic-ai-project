# Copy to .env and fill in real values. Never commit .env.

# -----------------------
# RIT API (direct)
# -----------------------
RIT_BASE_URL=https://api.genai.gccis.rit.edu/v1
RIT_API_KEY=INSERT_YOUR_RIT_API_KEY_HERE
RIT_DEFAULT_MODEL=qwen3-coder:30b
# comma-separated models to smoke-test in check_rit_connection.py
RIT_TEST_MODELS=qwen3:8b,qwen3-coder:30b,gemma4:26b,gemma4:latest

# -----------------------
# Model gateway (LiteLLM) - optional but recommended once you have
# more than one caller of models (e.g. multiple agent roles)
# -----------------------
MODEL_GATEWAY_PORT=4000
MODEL_GATEWAY_BASE_URL=http://localhost:4000/v1
LITELLM_MASTER_KEY=change_me_to_something_random

# -----------------------
# Optional local model server (vLLM/Ollama/SGLang), OpenAI-compatible.
# host.docker.internal only resolves from inside a container; scripts
# run natively on this host, so localhost is correct here.
# -----------------------
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL_API_KEY=local-not-needed
LOCAL_DEFAULT_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
